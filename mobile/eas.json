{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.11.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://somniav2.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.11.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://somniav2.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.11.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://somniav2.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
